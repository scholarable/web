{
  "name": "scholarable",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "cf:check": "npm run build && wrangler deploy --dry-run",
    "start": "react-router-serve build/server/index.js",
    "check": "react-router typegen && tsc --noEmit",
    "test": "tsx --test app/tests/*.test.ts",
    "demo": "react-router dev --mode demo --host 127.0.0.1 --port 5197 --strictPort",
    "build:demo": "react-router build --mode public-demo",
    "deploy:demo": "npm run build:demo && npm run check:demo && wrangler deploy --config wrangler.demo.jsonc",
    "check:demo": "node scripts/demo_preflight.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@workos-inc/authkit-react-router": "0.12.5",
    "jose": "^6.2.12",
    "parse5": "7.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.1"
  },
  "devDependencies": {
    "@react-router/dev": "^7.9.1",
    "@react-router/serve": "^7.9.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "pg": "^8.23.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "wrangler": "^4.0.0"
  }
}
