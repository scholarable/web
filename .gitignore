.mcp.json

# Local secrets
.env
.env.*
!.env.example

# Python tooling
.venv/
__pycache__/
*.py[cod]
.ruff_cache/

# Local operating-system and test output
.DS_Store
*.log

# React Router / Worker build output
node_modules/
build/
dist/
